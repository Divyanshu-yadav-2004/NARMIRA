generator client {
  provider = "prisma-client"
  output   = "../src/database/generated"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AdminRole {
  SUPER_ADMIN
  CATALOG_ADMIN
}

model Product {
  id              String              @id @default(cuid())
  name            String              @db.VarChar(180)
  slug            String              @unique @db.VarChar(200)
  description     String              @db.Text
  shortDescription String?             @db.VarChar(500)
  sku             String?             @unique @db.VarChar(80)
  basePrice       Decimal             @db.Decimal(12, 2)
  salePrice       Decimal?            @db.Decimal(12, 2)
  status          ProductStatus       @default(DRAFT)
  featured        Boolean             @default(false)
  bestseller      Boolean             @default(false)
  newArrival      Boolean             @default(false)
  material        String?             @db.VarChar(160)
  weaveOrigin     String?             @db.VarChar(160)
  careInstructions String?             @db.Text
  details         String[]            @default([])
  tags            String[]            @default([])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  images          ProductImage[]
  variants        ProductVariant[]
  sizes           ProductSize[]
  inventory       Inventory[]
  categories      ProductCategory[]
  collections     ProductCollection[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([status, createdAt])
  @@index([featured, status])
  @@index([bestseller, status])
  @@index([newArrival, status])
  @@index([material])
}

model Category {
  id          String            @id @default(cuid())
  name        String            @db.VarChar(120)
  slug        String            @unique @db.VarChar(140)
  description String?           @db.Text
  image       String?           @db.VarChar(2048)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sortOrder   Int               @default(0)
  products    ProductCategory[]

  @@index([isActive, name])
}

model Collection {
  id          String               @id @default(cuid())
  name        String               @db.VarChar(120)
  slug        String               @unique @db.VarChar(140)
  description String?              @db.Text
  image       String?              @db.VarChar(2048)
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  sortOrder   Int                  @default(0)
  products    ProductCollection[]

  @@index([isActive, name])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Restrict)

  @@id([productId, collectionId])
  @@index([collectionId, productId])
}

model ProductImage {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  imageUrl  String          @db.VarChar(2048)
  altText   String?         @db.VarChar(500)
  sortOrder Int             @default(0)
  isPrimary Boolean         @default(false)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [productId, variantId], references: [productId, id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@index([variantId, sortOrder])
}

model ProductVariant {
  id           String         @id @default(cuid())
  productId    String
  name         String         @db.VarChar(120)
  colorName    String         @db.VarChar(80)
  colorCode    String         @db.VarChar(16)
  sku          String?        @unique @db.VarChar(80)
  priceOverride Decimal?      @db.Decimal(12, 2)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images       ProductImage[]
  inventory    Inventory[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([productId, colorName])
  @@unique([productId, id])
  @@index([productId, isActive])
}

model ProductSize {
  id           String      @id @default(cuid())
  productId    String
  size         String      @db.VarChar(40)
  sku          String?     @unique @db.VarChar(80)
  priceOverride Decimal?   @db.Decimal(12, 2)
  isAvailable  Boolean     @default(true)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory[]
  inventoryAdjustments InventoryAdjustment[]

  @@unique([productId, size])
  @@unique([productId, id])
  @@index([productId, isAvailable])
  @@index([productId, sortOrder])
}

model Inventory {
  id               String         @id @default(cuid())
  productId        String
  variantId        String?
  sizeId           String?
  combinationKey   String         @default("default") @db.VarChar(180)
  stockQuantity    Int            @default(0)
  reservedQuantity Int            @default(0)
  version          Int            @default(0)
  updatedAt        DateTime       @updatedAt
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [productId, variantId], references: [productId, id], onDelete: Cascade)
  size             ProductSize?   @relation(fields: [productId, sizeId], references: [productId, id], onDelete: Cascade)
  adjustments      InventoryAdjustment[]

  @@unique([productId, combinationKey])
  @@index([productId, variantId, sizeId])
}

model AdminUser {
  id               String      @id @default(cuid())
  name             String      @db.VarChar(120)
  email            String      @unique @db.VarChar(254)
  passwordHash     String      @db.VarChar(255)
  role             AdminRole   @default(CATALOG_ADMIN)
  isActive         Boolean     @default(true)
  lastLoginAt      DateTime?
  passwordChangedAt DateTime   @default(now())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sessions         AdminSession[]
  auditLogs        AuditLog[]
  inventoryAdjustments InventoryAdjustment[]

  @@index([isActive, role])
}

model AdminSession {
  id            String    @id @default(cuid())
  adminId       String
  tokenHash     String    @unique @db.Char(64)
  csrfTokenHash String    @db.Char(64)
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime  @default(now())
  createdAt     DateTime  @default(now())
  admin         AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt, expiresAt])
}

model AuditLog {
  id         String    @id @default(cuid())
  adminId    String?
  action     String    @db.VarChar(80)
  entityType String    @db.VarChar(80)
  entityId   String?   @db.VarChar(191)
  requestId  String?   @db.VarChar(64)
  metadata   Json      @default("{}") @db.JsonB
  createdAt  DateTime  @default(now())
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model InventoryAdjustment {
  id               String         @id @default(cuid())
  inventoryId      String
  productId        String
  variantId        String?
  sizeId           String?
  adminId          String
  previousQuantity Int
  newQuantity      Int
  deltaQuantity    Int
  reason           String         @db.VarChar(500)
  createdAt        DateTime       @default(now())
  inventory        Inventory      @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  product          Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant          ProductVariant? @relation(fields: [productId, variantId], references: [productId, id], onDelete: Restrict)
  size             ProductSize?   @relation(fields: [productId, sizeId], references: [productId, id], onDelete: Restrict)
  admin            AdminUser      @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([adminId, createdAt])
  @@index([inventoryId, createdAt])
}
