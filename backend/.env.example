# Local PostgreSQL connection used by Prisma. Keep the password URL-safe or percent-encode it.
DATABASE_URL=""
POSTGRES_DB=narmira
POSTGRES_USER=narmira
POSTGRES_PASSWORD=
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
API_PREFIX=api/v1
# Comma-separated exact browser origins; no trailing slash.
FRONTEND_URL=http://localhost:5173
# Set true to expose Swagger in production; it is enabled automatically in development.
ENABLE_SWAGGER=false
